#!/usr/bin/env bash
#SBATCH --job-name=rdr-base --partition=scavenger --account=scavenger --qos=scavenger
#SBATCH --gres=gpu:1 --constraint="Ampere|Ada|Hopper|Blackwell" --exclude=cbcb26,clip04,clip11,clip14,cml12,cml17,cml18,cml19,cml20,cml21,cml22,cml23,cml24,cml25,cml26,cml27,cml28,gammagpu00,gammagpu01,gammagpu02,gammagpu03,gammagpu04,gammagpu05,gammagpu06,gammagpu07,gammagpu08,gammagpu09,tron06,tron07,tron08,tron09,tron10,tron11,tron12,tron13,tron14,tron15,tron16,tron17,tron18,tron19,tron20,tron21,tron22,tron23,tron24,tron25,tron26,tron27,tron28,tron29,tron30,tron31,tron32,tron33,tron34,tron35,tron36,tron37,tron38,tron39,tron40,tron41,tron42,tron43,tron44,tron45,tron46,tron47,tron48,tron49,tron50,tron51,tron52,tron53,tron54,tron55,tron56,tron57,tron58,tron59,tron60,tron61,tron64,tron67,vulcan33,vulcan34,vulcan35,vulcan36,vulcan37,vulcan38,vulcan39,vulcan40,vulcan41,vulcan42,vulcan43,vulcan44 --cpus-per-task=8 --mem=64G --time=06:00:00
#SBATCH --output=/fs/nexus-scratch/wuxiyang/reader_train/slurm_logs/base-%j.out --error=/fs/nexus-scratch/wuxiyang/reader_train/slurm_logs/base-%j.err
# Baseline for the trainable reader: Qwen3.5-9B (text prompt) served by vLLM, answering the fresh 300 over the narr_px_plus catalog, direct and direct+rationale.
set -uo pipefail; cd /fs/gamma-projects/vlm-robot/Video_Skills
export HF_HOME=/fs/gamma-projects/vlm-robot/Multi-hop-Reasoning-VLM-Agent/.hf_cache; export TRANSFORMERS_CACHE=$HF_HOME/hub
export CUDA_HOME=/opt/common/cuda/cuda-13.0.2; export CUDA_PATH=$CUDA_HOME; export PATH=$CUDA_HOME/bin:$PWD/.venv-qwen35-vllm/bin:$PATH
export VLLM_USE_DEEP_GEMM=0 TOKENIZERS_PARALLELISM=false SETUPTOOLS_USE_DISTUTILS=stdlib PYTHONPATH=$PWD
PORT=$((19000 + SLURM_JOB_ID % 1000)); MODEL=Qwen/Qwen3.5-9B
.venv-qwen35-vllm/bin/vllm serve $MODEL --host 127.0.0.1 --port $PORT --served-model-name $MODEL --dtype bfloat16 --max-model-len 32768 --gpu-memory-utilization 0.90 > /fs/nexus-scratch/wuxiyang/reader_train/slurm_logs/vllm-$SLURM_JOB_ID.log 2>&1 &
for i in $(seq 1 600); do curl -sf http://127.0.0.1:$PORT/v1/models >/dev/null && break; sleep 2; done; curl -sf http://127.0.0.1:$PORT/v1/models >/dev/null || { echo "vllm did not start"; exit 1; }
EP=http://127.0.0.1:$PORT/v1/chat/completions; SPY=.venv-qwen35-serve/bin/python; M=dataset_clip_wrapper/output/l2_paper_cg_vh_20260901/full_vh_mm
$SPY -m scripts.eval.measure_answer_chain --l1-glob "/fs/nexus-scratch/wuxiyang/vh_l1_levers/narr_px_plus/stages/*/04_l1_example.json" --indices-from all --conditions direct --example-ids $M/fresh_ids_300.txt --workers 8 --timeout-s 600 --skill-model openai/gpt-oss-120b --answer-model $MODEL --answer-api-base $EP --output $M/rdr_q35_9b_base_fresh300.json > $M/rdr_q35_9b_base_fresh300.log 2>&1
$SPY -m scripts.eval.measure_answer_chain --l1-glob "/fs/nexus-scratch/wuxiyang/vh_l1_levers/narr_px_plus/stages/*/04_l1_example.json" --indices-from all --conditions direct --rationale --example-ids $M/fresh_ids_300.txt --workers 8 --timeout-s 600 --skill-model openai/gpt-oss-120b --answer-model $MODEL --answer-api-base $EP --dump-rollouts $M/rdr_q35_9b_base_rationale_fresh300.rollouts.jsonl --output $M/rdr_q35_9b_base_rationale_fresh300.json > $M/rdr_q35_9b_base_rationale_fresh300.log 2>&1
for n in rdr_q35_9b_base_fresh300 rdr_q35_9b_base_rationale_fresh300; do f=$M/$n.rows.jsonl; r=$(cat $f|wc -l); c=$(grep -c '"correct": true' $f); echo "$n: $r rows, acc $(python3 -c "print(round(100*$c/max($r,1),1))")%"; done
